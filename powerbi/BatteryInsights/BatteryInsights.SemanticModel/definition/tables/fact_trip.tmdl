/// Per-trip energy, distance, climate load and anomaly scores.
table fact_trip
	lineageTag: 0ba37a31-3a85-5126-ad27-bc72ec3bb6d4

	/// Distance integrated from speed.
	measure 'Distance km' = SUM ( fact_trip[distance_km] )
		formatString: #,0
		displayFolder: Energy
		lineageTag: 46646363-cd08-5126-bbb7-096591ab0bf5

	/// Net battery energy per 100 km (drawn minus recovered), distance-weighted.
	measure Consumption = DIVIDE ( SUM ( fact_trip[energy_net_kwh] ), SUM ( fact_trip[distance_km] ) ) * 100
		formatString: 0.0
		displayFolder: Energy
		lineageTag: 3037574a-3d5e-5b97-82b5-0d5238a05150

	/// Consumption without heating and A/C, kWh per 100 km.
	measure Traction = DIVIDE ( SUM ( fact_trip[energy_net_kwh] ) - SUM ( fact_trip[heating_kwh] ) - SUM ( fact_trip[aircon_kwh] ), SUM ( fact_trip[distance_km] ) ) * 100
		formatString: 0.0
		displayFolder: Energy
		lineageTag: 5f03feb0-afa4-5011-86fa-5478cfda39d1

	/// Cabin heating energy per 100 km.
	measure Heating = DIVIDE ( SUM ( fact_trip[heating_kwh] ), SUM ( fact_trip[distance_km] ) ) * 100
		formatString: 0.0
		displayFolder: Energy
		lineageTag: 7feca529-7e0d-5de4-9439-10676b7c5f68

	/// A/C energy per 100 km.
	measure 'Air conditioning' = DIVIDE ( SUM ( fact_trip[aircon_kwh] ), SUM ( fact_trip[distance_km] ) ) * 100
		formatString: 0.0
		displayFolder: Energy
		lineageTag: c50fa4ec-ddd8-5bdd-ba5d-3871af1d4c46

	/// Share of battery energy spent on cabin heating.
	measure 'Heating Share' = DIVIDE ( SUM ( fact_trip[heating_kwh] ), SUM ( fact_trip[energy_out_kwh] ) )
		formatString: 0.0%
		displayFolder: Energy
		lineageTag: db12d38d-6003-5c6f-a5f9-6599f1c993b4

	/// Share of drawn energy recovered by regenerative braking.
	measure 'Regen Share' = DIVIDE ( SUM ( fact_trip[energy_regen_kwh] ), SUM ( fact_trip[energy_out_kwh] ) )
		formatString: 0.0%
		displayFolder: Energy
		lineageTag: 4ea21bea-ec1e-5e41-abf6-4fb72d59b0e7

	/// Mean ambient temperature while driving.
	measure 'Ambient Temp' = AVERAGE ( fact_trip[ambient_mean_c] )
		formatString: 0.0
		displayFolder: Energy
		lineageTag: 27d90a3c-b093-58d0-afcf-cc828a69f5b3

	column trip_id
		dataType: string
		lineageTag: b17c1171-380b-597e-a478-cadd276a0627
