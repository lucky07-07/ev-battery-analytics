	partition fact_trip = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_trip.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"trip_id", type text}, {"distance_km", type number}, {"energy_out_kwh", type number}, {"energy_regen_kwh", type number}, {"energy_net_kwh", type number}, {"heating_kwh", type number}, {"aircon_kwh", type number}, {"energy_charged_kwh", type number}, {"mean_speed_kmh", type number}, {"ambient_mean_c", type number}, {"batt_temp_rise_c", type number}, {"expected_kwh_per_100km", type number}, {"isolation_score", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
