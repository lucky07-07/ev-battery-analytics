/// Anomaly register with root-cause notes.
table fact_anomaly
	lineageTag: ed355a83-7640-554c-aa6f-89ceaf21cc05

	/// Flags raised by all detectors.
	measure 'Anomaly Flags' = COUNTROWS ( fact_anomaly )
		formatString: #,0
		displayFolder: Anomalies
		lineageTag: 4522a566-15e7-5a46-bd3e-8ff046633959

	/// Trips with at least one flag.
	measure 'Flagged Trips' = DISTINCTCOUNT ( fact_anomaly[trip_id] )
		formatString: #,0
		displayFolder: Anomalies
		lineageTag: de8c381a-8453-50cf-97bf-a103d98aa0db

	column flag_id
		dataType: int64
		formatString: 0
		lineageTag: a7791b59-0d2e-525f-8ec8-f54e767e49e7
		summarizeBy: none
		sourceColumn: flag_id

		annotation SummarizationSetBy = User

	column detector
		dataType: string
		lineageTag: e10d65f9-7880-519a-a9b5-86b7c6d31ab3
		summarizeBy: none
		sourceColumn: detector

		annotation SummarizationSetBy = User

	column level
		dataType: string
		lineageTag: a5336591-80db-5479-a420-68e193210e55
		summarizeBy: none
		sourceColumn: level

		annotation SummarizationSetBy = User

	column trip_id
		dataType: string
		lineageTag: 0c4684a9-d733-563d-84cc-791cc3d2a755
		summarizeBy: none
		sourceColumn: trip_id

		annotation SummarizationSetBy = User

	column score
		dataType: double
		lineageTag: 2a3d11cd-5d54-5803-90f2-9e46d3e1cde3
		summarizeBy: none
		sourceColumn: score

		annotation SummarizationSetBy = User

	column reason
		dataType: string
		lineageTag: a6eca99d-b31a-546b-9b4c-6aab23af32f1
		summarizeBy: none
		sourceColumn: reason

		annotation SummarizationSetBy = User

	column detector_short
		dataType: string
		lineageTag: f4302001-d61a-5156-a852-ba5a62d0c068
		summarizeBy: none
		sourceColumn: detector_short

		annotation SummarizationSetBy = User

	partition fact_anomaly = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_anomaly.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"flag_id", Int64.Type}, {"detector", type text}, {"level", type text}, {"trip_id", type text}, {"score", type number}, {"reason", type text}, {"detector_short", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
